# Server-side only. Never put secrets in the Chrome extension.

OPENAI_API_KEY=
# Optional: override vision models (defaults: gpt-4o, claude-sonnet-4-5)
# OPENAI_SCAN_MODEL=gpt-4o
# ANTHROPIC_SCAN_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# Simple spreadsheet store (Google Apps Script webhook) — enough for Cohort 1
# See docs/SHEET_STORE.md
SHEET_WEBHOOK_URL=
# SHEET_WEBHOOK_SECRET=

# Supabase (optional if sheet webhook is set)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar + Gmail (stylist context)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://youryom.com/api/google/callback
APP_BASE_URL=https://youryom.com
# GOOGLE_TOKEN_SECRET=

# PostHog (public project key — also paste into extension/analytics-config.js)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Capacitor native app — API origin (defaults to https://www.youryom.com)
# VITE_API_ORIGIN=https://www.youryom.com

# Optional: add beta emails via POST /api/allow
# YOM_ADMIN_SECRET=

# Optional: YouTube Data API key — finds try-on hauls / GRWMs (titles + descriptions)
# YOUTUBE_API_KEY=
