{
  "manifest_version": 3,
  "name": "yom — Reformation demo",
  "version": "1.0.0",
  "description": "yom shopping companion on Reformation — browsing or purpose-driven, character pops in when useful.",
  "action": {
    "default_title": "yom demo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://www.thereformation.com/*",
    "https://thereformation.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.thereformation.com/*",
        "https://thereformation.com/*"
      ],
      "css": ["content/overlay.css"],
      "js": ["content/data.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": [
        "https://www.thereformation.com/*",
        "https://thereformation.com/*"
      ]
    }
  ]
}
