{
  "manifest_version": 3,
  "name": "yom",
  "version": "1.1.1",
  "description": "yom shopping companion — marks the page, follows what you told it, thinks when you give it a key.",
  "action": {
    "default_title": "yom",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["content/overlay.css"],
      "js": ["content/data.js", "content/extract.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "content/overlay.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
